# Copy to .env.local and fill in for production. For local dev with the
# emulator, set VITE_FIREBASE_EMULATORS=1 and the real values can be anything.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# When set to "1", the client connects to the Firebase Local Emulator Suite
# at localhost:9099 (auth) and localhost:8080 (firestore) instead of prod.
VITE_FIREBASE_EMULATORS=
