{
  "name": "sudoku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "emulators": "firebase emulators:start --only auth,firestore --project sudoku-emulator",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore",
    "test": "firebase emulators:exec --only auth,firestore --project sudoku-emulator \"playwright test\"",
    "test:ui": "firebase emulators:exec --only auth,firestore --project sudoku-emulator \"playwright test --ui\"",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.18.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
